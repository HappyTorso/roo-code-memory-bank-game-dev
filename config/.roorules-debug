umb:
  trigger: "^(Update Memory Bank|UMB)$"
  instructions:
    - "Halt Current Task: Stop current activity"
    - "Acknowledge Command: '[MEMORY BANK: UPDATING]'"
    - "Review Chat History"
  temporary_god-mode_activation: |
      1. Access Level Override:
          - Full tool access granted
          - All mode capabilities enabled
          - All file restrictions temporarily lifted for Memory Bank updates.
      2. Cross-Mode Analysis:
          - Review all mode activities
          - Identify inter-mode actions
          - Collect all relevant updates
          - Track dependency chains
  core_update_process: |
      1. Current Session Review:
          - Analyze complete chat history
          - Extract cross-mode information
          - Track mode transitions
          - Map activity relationships
      2. Comprehensive Updates:
          - Update from all mode perspectives
          - Preserve context across modes
          - Maintain activity threads
          - Document mode interactions
      3. Memory Bank Synchronization:
          - Update all affected *.md files
          - Ensure cross-mode consistency
          - Preserve activity context
          - Document continuation points
  task_focus: "During a UMB update, focus on capturing any clarifications, questions answered, or context provided *during the chat session*. This information should be added to the appropriate Memory Bank files (likely `activeContext.md` or `decisionLog.md`), using the other modes' update formats as a guide.  *Do not* attempt to summarize the entire project or perform actions outside the scope of the current chat."
  cross-mode_updates: "During a UMB update, ensure that all relevant information from the chat session is captured and added to the Memory Bank. This includes any clarifications, questions answered, or context provided during the chat. Use the other modes' update formats as a guide for adding this information to the appropriate Memory Bank files."
  post_umb_actions:
    - "Memory Bank fully synchronized"
    - "All mode contexts preserved"
    - "Session can be safely closed"
    - "Next assistant will have complete context"
    - "Note: God Mode override is TEMPORARY"
  override_file_restrictions: true
  override_mode_restrictions: true

workflows:
  architectural_guardrail_check:
    trigger: Before calling `apply_diff` or `write_to_file` (less common in Debug, but possible for logging changes etc.).
    steps:
      - Analyze the intended file path and the content of the diff/write operation.
      - Check if the change matches defined "Potentially Significant Architectural Change" triggers (dependency files, core components, structure, core APIs).
      - If a trigger is matched:
        - Halt the file modification.
        - Switch mode to `architect`.
        - Provide context: "Requesting architectural review for proposed change during debugging: [Trigger description]. Change details: [Show diff/summary]."
      - If no trigger is matched: Proceed with the file modification tool call.
  failure_handling:
    trigger: When a fix attempt (potentially implemented by Code mode based on Debug analysis) is validated and found to be unsuccessful (via User, Test, or PM feedback).
    steps:
      - Read `activeContext.md` to get current task/issue ID and failure count.
      - Increment `Consecutive Failed Attempts` count for the task/issue ID.
      - Use `apply_diff` to update the count in `activeContext.md`.
      - Check if new count >= 3 (Threshold).
      - If Yes (Threshold reached):
        - Update `activeContext.md` status note: "Failure threshold (3) reached for [TASK/ISSUE_ID]. Escalating."
        - Update `issuesLog.md` for the relevant issue: Add note "[YYYY-MM-DD HH:MM:SS] - Recurring failure threshold reached. Escalating to Game PM."
        - Switch mode to `architect`.
        - Provide context: "Recurring failure threshold reached for issue '[Issue ID]' after 3 attempts. Requesting review and guidance."
      - If No (Threshold not reached):
        - Analyze the failure feedback.
        - Continue debugging investigation, potentially trying a different approach. Update `issuesLog.md` with new findings.
  web_search_request:
    trigger: Receiving handoff from Architect/Game PM or determining during investigation that external technical information is needed.
    steps:
      - Formulate a specific query related to the error message, library behavior, or technical problem.
      - Use the `use_mcp_tool` for `OpenAIResponsesServer` / `get_openai_response`.
        - server_name: OpenAIResponsesServer
        - tool_name: get_openai_response
        - arguments: {"query": "[Specific technical query]"}
      - Analyze the web search result for relevant solutions or insights.
      - Document findings in the "Investigation Notes" section of the relevant issue in `issuesLog.md` using `apply_diff`.
      - Proceed with debugging based on findings or report back to Architect/Game PM if initiated there.
  issue_logging:
    trigger: When starting investigation on a new issue or updating an existing one.
    steps:
      - If new issue: Use `apply_diff` to append a new issue block (using the template) to `issuesLog.md`. Populate Reported, Status (Open), Severity, Description, Reproduction Steps.
      - If existing issue: Use `apply_diff` to update Status (Investigating), add timestamped Investigation Notes, or add Resolution details.